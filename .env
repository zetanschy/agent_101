# ─── Shared LeRobot config ─────────────────────────────────────────────
# Everything the wrapper scripts reuse lives here. Change it once.

# Robot (follower) ------------------------------------------------------
ROBOT_TYPE=so101_follower
ROBOT_PORT=/dev/ttyACM1
ROBOT_ID=zetans_follower

# Teleoperator (leader) -------------------------------------------------
TELEOP_TYPE=so101_leader
TELEOP_PORT=/dev/ttyACM0
TELEOP_ID=zetans_leader

# Cameras ---------------------------------------------------------------
# These indices are the FIXED container /dev/videoN nodes that docker-compose.yml
# pins to each camera by USB serial — stable regardless of host renumbering.
CAM_FRONT_INDEX=4
CAM_GRIP_INDEX=6
CAM_SIDE_INDEX=1
CAM_WIDTH=640
CAM_HEIGHT=480
CAM_FPS=30
CAM_FOURCC=MJPG

# Rerun live visualization (--display_data). Needs X11 passthrough.
DISPLAY_DATA=true

# JAX GPU memory ---------------------------------------------------------
# Fraction of TOTAL VRAM that JAX preallocates on first use. Total, not free:
# on this 12 GB card 0.9 asks for 11059 MiB while the desktop already holds
# ~800 MiB, so the allocation fails and inference dies at kernel load with
# "cudaGetFuncBySymbol: out of memory". 0.75 leaves ~2.2 GB for the desktop
# and for torch, which shares the GPU in the main image. Raise it on a box
# with a dedicated card.
XLA_MEM_FRACTION=0.75
# Inference (openpi + openpi-dagger). Lower on purpose: the cap-to-cup checkpoint
# needs 6.9 GB at peak, and 0.75 of a 12 GB card is 9.2 GB -- more than is free once
# the desktop and anything else are up, so the run OOMs after loading. Training keeps
# 0.75 above, where it is the process that wants the whole card.
XLA_MEM_FRACTION_INFER=0.65

# Weights & Biases (training logs) --------------------------------------
# train.sh enables wandb automatically once a key is available. This file is
# TRACKED — keep the key out of it, put it in .env.local (gitignored):
#   echo 'WANDB_API_KEY=<key from wandb.ai/authorize>' >> .env.local
WANDB_PROJECT=agent_101
# WANDB_ENTITY=your-team          # only if logging to a team, not your own account

# Dataset defaults (override per-run with flags) ------------------------
HF_USER=soarm101
DATASET_FPS=30
EPISODE_TIME_S=30
RESET_TIME_S=30
PUSH_TO_HUB=false

# Isaac Sim (sim2real) -----------------------------------------------------
# Native conda env, not Docker: Isaac Sim needs the GPU plus a large shader and
# asset cache in $HOME. 45pysaac = Isaac Sim 4.5.0 + Isaac Lab 2.1.0, the one that
# boots on this box; env_isaaclab (5.1.0 + 2.3.0) hangs in Kit startup.
SIM_CONDA_ENV=45pysaac
SIM_CONDA_ROOT=/home/zetans/anaconda3
